services:
  caddy:
    image: iarekylew00t/caddy-cloudflare:latest
    container_name: caddy
    restart: always
    ports:
        - "443:443"
        - "80:80"
    environment:
        - CF_API_TOKEN={{ cloudflare_api_token }}
    volumes:
        - ./config/caddyfile:/etc/caddy/Caddyfile
        - ./config/caddy_data:/data
        - ./config/caddy_config:/config
