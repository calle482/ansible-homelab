services:
  pihole:
    container_name: pihole
    image: pihole/pihole:latest
    network_mode: host
    environment:
      TZ: 'Europe/Stockholm'
      FTLCONF_webserver_api_password: '{{ pihole_admin_password }}'
      FTLCONF_dns_listeningMode: 'all'
      FTLCONF_dns_upstreams: '194.242.2.2#443'
      PIHOLE_UID: {{ pihole_uid.stdout }}
      PIHOLE_GID: {{ pihole_gid.stdout }}
    volumes:
      - './config/etc-pihole:/etc/pihole'
      - './config/etc-dnsmasq.d:/etc/dnsmasq.d'
    cap_add:
      - NET_ADMIN # Required if you are using Pi-hole as your DHCP server, else not needed
      - SYS_NICE # Optional, if Pi-hole should get some more processing time
    restart: always
